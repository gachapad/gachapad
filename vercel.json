{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gachapad.185-184-195-206.sslip.io/v2/:path*" },
    { "source": "/m/:file", "destination": "https://gachapad.185-184-195-206.sslip.io/v2/m/:file" },
    { "source": "/img/:mint", "destination": "https://gachapad.185-184-195-206.sslip.io/v2/img/:mint" },
    { "source": "/events", "destination": "https://gachapad.185-184-195-206.sslip.io/v2/events" },
    { "source": "/((?!assets/|api/|m/|img/|events).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
