# Engine base URL, no trailing slash. Unset = http://localhost:3071 in dev (node backend/scripts/dev-engine.mjs) and
# /api in production (the site host rewrites /api/* to the engine, see vercel.json).
# VITE_API_URL=https://engine.example.com
# 1 = serve the API from src/mock.js in the browser (no engine needed). Never set in prod.
VITE_MOCK=
