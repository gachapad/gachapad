# Gachapad engine. Copy to .env (chmod 600). Never commit .env. Every other tunable and its default: config.js.
NODE_ENV=production
BRAND=GACHAPAD
TICKER=GACHA
SITE_URL=https://www.gachapad.tech
# the engine's own public URL (behind your TLS proxy)
PUBLIC_URL=
PORT=3065
HOST=127.0.0.1
TRUST_PROXY=true
RPC_URL=

# base58 or JSON array. ENGINE_PRIVATE_KEY derives every coin key, pool and vault: never rotate it once coins exist.
ENGINE_PRIVATE_KEY=
BURN_PRIVATE_KEY=
PROTOCOL_WALLET=
ADMIN_SECRET=

# the ROOT coin ($GACHA), launched on pump.fun, then adopted with POST /admin/root/adopt
ROOT_MINT=

# optional: the machines a coin may pick (default list in config.js) and the most one pack may cost
# PACK_CODES=pokemon_25,pokemon_50,pokemon_100,onepiece_50
PACK_MAX_USDC=100
# optional: pin metadata to IPFS instead of self-hosting it under SITE_URL/m/
PINATA_JWT=

# live flags: all off by default, turn on one at a time (DEPLOY.md)
LAUNCH_ENABLED=false
DISTRIBUTE_LIVE=false
CONVERT_LIVE=false
RIP_LIVE=false
PULLS_LIVE=false
DELIVER_LIVE=false
BURN_LIVE=false
